<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Transparent fill -->
    <solid android:color="@android:color/transparent" />

    <!-- Off-white outline -->
    <stroke
        android:width="3dp"
        android:color="#FFFFFF" />

    <!-- Size of the circle -->
    <size
        android:width="80dp"
        android:height="80dp" />
</shape>
